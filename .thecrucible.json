{
  "$schema": "https://raw.githubusercontent.com/jonathanblunt1214-lgtm/The-Crucible/main/.thecrucible.schema.json",
  "schemaVersion": 1,
  "project": {
    "name": "SmokeStack",
    "projectId": "smokestack"
  },
  "commands": {
    "prepare": [
      { "name": "Install locked dependencies", "run": "npm", "args": ["ci", "--ignore-scripts", "--no-audit", "--no-fund"] }
    ],
    "verify": [
      { "name": "Agent governance", "run": "npm", "args": ["run", "test:agent-governance"] },
      { "name": "TypeScript and trusted-runtime validation", "run": "npm", "args": ["run", "lint"] },
      { "name": "CharGPT capability contracts", "run": "npm", "args": ["run", "test:chargpt-contract"] },
      { "name": "Database harvester contracts", "run": "npm", "args": ["run", "test:database-harvesters"] },
      { "name": "Operations dashboard contracts", "run": "npm", "args": ["run", "test:operations-dashboard"] },
      { "name": "Production build", "run": "npm", "args": ["run", "build"] }
    ]
  },
  "artifacts": ["dist/server.cjs"],
  "clutter": {
    "allow": [],
    "allowDuplicateContent": false
  },
  "privacy": {
    "githubIdentity": "jonathanblunt1214-lgtm",
    "allow": [
      { "path": "src/data/**", "reason": "Reviewed SmokeStack database records must never be automatically rewritten.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "src/utils/fuelDatabase.ts", "reason": "Reviewed database module is protected from automatic privacy cleanup.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "src/utils/smokerManufacturerData.ts", "reason": "Reviewed manufacturer dataset is protected from automatic privacy cleanup.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "src/utils/storage.ts", "reason": "Reviewed storage layer is protected from automatic privacy cleanup.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" },
      { "path": "src/lib/firestoreData.ts", "reason": "Reviewed database integration is protected from automatic privacy cleanup.", "owner": "jonathanblunt1214-lgtm", "expires": "2027-08-24" }
    ]
  },
  "security": {
    "allow": [],
    "allowBinaries": [],
    "dependencyAudit": [
      { "name": "High-severity npm dependency audit", "run": "npm", "args": ["audit", "--audit-level=high", "--omit=dev"] }
    ]
  },
  "authenticity": {
    "requireArtifacts": true,
    "claims": [
      { "name": "Repository governance protections are enforced", "run": "npm", "args": ["run", "test:agent-governance"], "evidence": ["AGENTS.md"] }
    ]
  },
  "governance": { "requireExceptionMetadata": true, "failOnDisabledSecurity": true },
  "workload": {
    "workers": 1,
    "cycles": 1,
    "timeoutMinutes": 30,
    "maxOutputBytes": 1048576,
    "execution": { "network": "allow", "denyBackground": true }
  }
}
