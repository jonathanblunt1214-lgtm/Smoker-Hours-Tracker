# SmokeStack trusted runtime configuration
# Copy this file to a local .env file for development. Never commit real secrets.

# CharGPT model provider credential. Keep this server-side only.
GEMINI_API_KEY=""

# Optional Gemini model override. The stable default is gemini-2.5-flash.
# Use a model name available to the API key configured above.
GEMINI_MODEL="gemini-2.5-flash"

# Public application URL used for callbacks and application links.
APP_URL="http://localhost:3000"

# Firebase / Google Cloud project used by the server-side Admin SDK.
FIREBASE_PROJECT_ID=""

# Optional for local/non-Google runtimes. Prefer Application Default Credentials
# on Cloud Run. When used, provide the COMPLETE service-account JSON as a
# single environment-variable value. Never expose this to the browser bundle.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# One-time OWNER bootstrap. Set exactly one of these when running:
#   npm run bootstrap:owner
# Prefer the Firebase UID after the owner account has signed in once.
SMOKESTACK_OWNER_UID=""
SMOKESTACK_OWNER_EMAIL=""

# Deployment environment marker used by operations/diagnostics.
SMOKESTACK_ENV="development"
