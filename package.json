{
  "name": "react-example",
  "private": true,
  "version": "0.02A",
  "smokestack": {
    "buildNumber": 2814,
    "channel": "alpha",
    "webUrl": "/",
    "minimumSupportedVersion": "0.02A"
  },
  "type": "module",
  "scripts": {
    "generate:release": "node scripts/generate-release-metadata.mjs",
    "check:constitution": "node scripts/check-constitution.mjs",
    "dev": "npm run generate:release && npm run check:constitution && tsx server.ts",
    "build": "npm run generate:release && npm run check:constitution && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist .generated server.js",
    "lint": "npm run check:constitution && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node scripts/test-product-contracts.mjs",
    "test:firestore-rules": "npx --yes firebase-tools@15.27.0 emulators:exec --project=smokestack-rules-test --only firestore \"node scripts/test-firestore-rules.mjs\"",
    "verify:owner-security": "npm run check:constitution && tsc --noEmit",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^13.4.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
