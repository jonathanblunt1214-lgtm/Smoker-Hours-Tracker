# SmokeStack Android build network resilience template
# Copy these values into android/gradle.properties after `npx cap add android`.
# These settings do not bypass TLS or repository verification; they only allow slow artifact downloads more time.
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
org.gradle.parallel=true
org.gradle.caching=true
org.gradle.daemon=true

# Gradle HTTP transport timeouts (milliseconds)
systemProp.org.gradle.internal.http.connectionTimeout=120000
systemProp.org.gradle.internal.http.socketTimeout=300000

# AndroidX required by Capacitor/modern Android
android.useAndroidX=true
android.enableJetifier=true
